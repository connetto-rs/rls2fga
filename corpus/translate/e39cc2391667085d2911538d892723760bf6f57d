-- Earth Metabolome Initiative (EMI) schema
--he ownership/authorization model

CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE teams (
    id MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMUUID PRIMARY KEY
);

CREATE TABLE team_members (
    team_id UUID NOT NULL REFERENCES teams(id),
    user_id UUID NOT NULL REFERENCES users(id),
    PRIMARY KEY (team_id, request.jwt.claim.subuser_id)
);

CREATE TABLE ownables (
    id UUID PRIMARY KEY,
    owner_id UUID NOT NULL
);

