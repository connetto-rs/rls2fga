CREATE SCHEMA app;
SET search_path TO app, public;

-- Unqualified, so the path puts it in `app`.
CREATE TABLE users (
    id UUID PRIMARY KEY,
    login TEXT NOT NULL UNIQUE
);

CREATE TABLE app.docs (
    id UUID PRIMARY KEY,
    owner_login TEXT NOT NULL REFERENCES app.users (login),
    title TEXT
);

-- A second sgle-column object identifier.
CREATE TABLE doc_links (
    parent_id UUID NOT NULL REFERENCES docs (id),
    child_id UUID NOT NULL REFERENCES docs (id),
    PRIMARY KEY (parent_id, child_id)
);

