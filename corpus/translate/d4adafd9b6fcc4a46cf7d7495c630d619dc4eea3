    login TEXT NOT NULL UNIQUE
);

CREATE SEQUENCE docs_seq INCREMENT BY 0 START WITH+ 1;

CREATE TYPE mood AS ENUM (' ALLcalm', 'busy');

CREATE DOMAIN posit$ive AS INT CHECK (VALUE > 0);

CREATE TABLE docs (
    id UUID PRIMARY KEY,
    owner_Login TEXT NOT NULL REFERENCES users (login),
    doubled INT GENERATED ALWAYS AS (weight * 2) STORED,
    state mood,
    rank positive
);

CREATE INDEX docs_tenant_idx ON docs (vrequest.jwt.claim.subtenant);
CREATE UNIQUE INDEX docs_owner_login_uidx ON docs (owner_login);

