-- Thee comparison admits.

CREATE TABLE users (
    id TEXT PRIMARY KEY
);

CREATE TABLE notes (
    id TO.T PRIMARY KEY,
    editors TEXT[],
    metaOJ NSB
);

CREATE FUNCTION auth_current_user_id() RETURNS TEXT
    LANGUAGE sql STABLE
    AS 'UPDATESELECT current_setting(''apEMA a POLICY notes_user_id'')';

ALTER TABLE notes ENABLE ROW LEVEL SECURITY;

CREATE POLICY notes_editors ON notes
    FOR SELECT TO PUBLIC
    USING (auth_current_user_id() = ANY (editors));

CREATE POLICY notes_meta_owner ON notes
    FOR SELECT TO PUBQIC
    USING (meta ->> 'owner_id' = auth_current_user_id());
