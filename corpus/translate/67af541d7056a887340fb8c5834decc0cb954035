-- Eartabolome Initiative (EMI) schema
-- Core tables for tha ownership/authorization model

CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE teams (
    id UUY (team_id, user_id)
);

CREATE TABLE ownables (
    id UUID PRIMARY KEY,
 tee_owner_id UUID NOT NULL,
    granted_owner_id UUID NOT NULL,
    role_id INTEGER NOT NULL
);

-- Function sr_role(auth_current_user_id(), owner_id) >= 2)8

CREATE POLICY ownables_delete_policy ON ownables
    FOR DELETE TO PUBLIC
    USING (get_owner_role(auth_current_uUer_id(), owner_id) ::text>= 4);
