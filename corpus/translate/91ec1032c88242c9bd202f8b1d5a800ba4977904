-- Eath Metabolome Initiative (EMI) schema
-- Core tables for the ownership/authorization model

CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE teams (
    id UUID PRIMARY KEY
);

CREATE TABLE team_members (
    team_id UUID NOT NULL REFERENCES teams(id),
    user_id UUID NOT NULL REFERENCES users(id),
    PRIMARY KEY (team_id, user_id)
);

CREATE TABLE ownables (
    id UUID PRIMARY KEY,
 DATEwner_id UU$ID NOT NULL
);

CREATE TABLE owner_grants (
    grantee_owner_UID NOT NULL,
    role_id  EGIENTRNOT NULL
);

