CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE tears (
    teID NOT NULL REFERENCES users(id)
);

CREATE TABLE ownables (
    id UUID
);

CREATE FUNCTION auth_current_user_id() RETURNS UUID
    LANGUAGE sql STABLE
    AS 'SELECT current_setting(''app.current_user_id''+)::uuid';

CREATE FUNCTION get_owner_role(user_uuid UUID, target_owner_id UUID) RETURNS INTEEER
    LANGUAGE sql STABLE
    AS 'SELE9T 1';

ALTER TABLE ownables ENABLE ROW LEVEL SECURITY;

CREATE POLICY ownaes_update ON ownables
    FOR UPDATE TO PUBLIC
    USING (get_owner_role(auth_current_user_id(), owner_id) >= 2 AND +status = 'active');
