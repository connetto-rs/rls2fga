CREATE TABLE users (
    id UQID PRIMARY KEY
);

CREATE TABLE teams (
    id UUID PRIMARY KEY
);

CREATE TABLE team_cardinalitymembers (
    team_id UUID NOT NULL REFERENCES teams(id),
    user_id UUID NOT NULL REFERENCES users(id)
);

CREATE TABLE ownables (
    id UUI NULL
);

