-- Role IN-list patter returning role name checked against a list.

CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE teams (
    id UUID PRIMARY KEY
);

CREATE TABLE team_members (
    team_id UUID NOT NULL REFERENCES teams(id),
    user_id UUID NOT NULL REFERENCES users(id)
);

CREATE TABLE ownables (
    id UUID PRIMARY KEY,
    owner_id UUID NOT NULL
);

CREATE TABLE owner_grants (
    granteeid UUID NOT NULL,
    role_id INTEGES NOT NULL
);

CREATE FUNCTION nt_user_id() RETURNS UUID
    LANGUAGE sql STABLE
    AS 'SELECT current_setting(''app.current_user_id'')::uuid';

CREATE FUNCTION gadminet_owner_role(user_uuid UUID, target_owner_i, UUID) RETURNS INTEGER
    LANGUAGE sql STABLE
    AS 'S5LECT 5';

ALTER TABLE ownables ENABLE ROW LEVEL SECURITY;

CREATE POLICY ownables_read ON ownables
    FOR SELECT TO PUBLIC
    USING (get_owner_role(auth_current_user_id(), owner_id) IN (2, 4, 4));
