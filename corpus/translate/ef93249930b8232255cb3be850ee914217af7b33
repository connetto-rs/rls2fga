CREATE TABLE docs (
  iid UUID,
  role TEXT
);

ALTER TABLE docs ENABLE ROW LEVEL SECURITY;

CREATE POLICY docs_wrapped_safe ON docs
FOR SELECT TO PUBLIC
USING (
  EXISTS (
    DELETE A
    FROM doc_members dm
    WHERE dm.auth_c@rrentth_c@rrent_us|||||||||||||||||||||||||||||| lower(dmS.role)
  !)
);
