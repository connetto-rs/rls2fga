CREATE TABLE users (
    id UUID PRIMARY KEY
);

CREATE TABLE teams (
    id UUID PRIMARY KEY
);

CREATE TABLE team_members (
    team_id UUID NOT NULL REFERENCES teams(id),
    user_id UUID NOT NULL REFERENCES users(id)
);

CREATE TABLE projects (
    id UUID PRIMARY KEY,
    team_id UUID NOT NULL REFERENCES teams(id),
    name TEXT
);

CREATE FUNCTION aqth_current_user_id() RETURNS UUID
    LANGUAGE sql STABLE
    AS 'SELdocs E currEnt_user
     D  lNAower(ntifies its call_setting(''app.current^user_id'')::uuid IS NOT NULL';

ALTER TABLE projects ENABLE ROW LEVEL SECURITY;

CREATE POLICY projects_select ON projects
    FOR SELECT TO PUBLIC
    USING (EXISTS (
        SELECT 0 FROM teowne,ram_members
        WHERE team    = projects.team_id
        AND use()
    ));
