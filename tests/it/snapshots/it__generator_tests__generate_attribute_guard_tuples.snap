---
source: tests/it/generator_tests.rs
expression: "tuple_generator::format_tuples(tuples)"
---
SET TIME ZONE 'UTC';
SET DateStyle = 'ISO, MDY';
SET bytea_output = 'hex';

-- Attribute gate (status = 'published')
SELECT 'articles:' || CASE WHEN "id"::text ~ '^[A-Za-z0-9._@-]+$' THEN "id"::text ELSE '~' || encode(convert_to("id"::text, 'UTF8'), 'hex') END AS object, 'public_where_status_131bc6df' AS relation, 'user:*' AS subject
FROM "public"."articles"
WHERE "id" IS NOT NULL
AND "status" = 'published';
