---
source: tests/it/generator_tests.rs
expression: "tuple_generator::format_tuples(outputs.tuple_queries())"
---
SET TIME ZONE 'UTC';
SET DateStyle = 'ISO, MDY';
SET bytea_output = 'hex';

-- User ownership (owner_id references users)
SELECT 'projects:' || CASE WHEN "id"::text ~ '^[A-Za-z0-9._@-]+$' THEN "id"::text ELSE '~' || encode(convert_to("id"::text, 'UTF8'), 'hex') END AS object, 'owner' AS relation, 'user:' || CASE WHEN "owner_id"::text ~ '^[A-Za-z0-9._@-]+$' THEN "owner_id"::text ELSE '~' || encode(convert_to("owner_id"::text, 'UTF8'), 'hex') END AS subject
FROM "public"."projects"
WHERE "owner_id" IS NOT NULL
AND "id" IS NOT NULL
AND octet_length('user:' || CASE WHEN "owner_id"::text ~ '^[A-Za-z0-9._@-]+$' THEN "owner_id"::text ELSE '~' || encode(convert_to("owner_id"::text, 'UTF8'), 'hex') END) <= 512;

-- projects admits requests acting as PostgreSQL role 'app_user', which the deployment decides rather than any row
SELECT 'request_gate:projects' AS object, 'acting_app_user' AS relation, 'pg_role:app_user' || '#usage' AS subject;

-- Every projects row is judged by the scope projects
SELECT 'projects:' || CASE WHEN "id"::text ~ '^[A-Za-z0-9._@-]+$' THEN "id"::text ELSE '~' || encode(convert_to("id"::text, 'UTF8'), 'hex') END AS object, 'request_gate' AS relation, 'request_gate:projects' AS subject
FROM "public"."projects"
WHERE "id" IS NOT NULL;

-- tasks to projects bridge for tuple-to-userset
SELECT 'tasks:' || CASE WHEN "id"::text ~ '^[A-Za-z0-9._@-]+$' THEN "id"::text ELSE '~' || encode(convert_to("id"::text, 'UTF8'), 'hex') END AS object, 'projects' AS relation, 'projects:' || CASE WHEN "project_id"::text ~ '^[A-Za-z0-9._@-]+$' THEN "project_id"::text ELSE '~' || encode(convert_to("project_id"::text, 'UTF8'), 'hex') END AS subject
FROM "public"."tasks"
WHERE "id" IS NOT NULL
AND "project_id" IS NOT NULL;

-- tasks admits requests acting as PostgreSQL role 'app_user', which the deployment decides rather than any row
SELECT 'request_gate:tasks' AS object, 'acting_app_user' AS relation, 'pg_role:app_user' || '#usage' AS subject;

-- Every tasks row is judged by the scope tasks
SELECT 'tasks:' || CASE WHEN "id"::text ~ '^[A-Za-z0-9._@-]+$' THEN "id"::text ELSE '~' || encode(convert_to("id"::text, 'UTF8'), 'hex') END AS object, 'request_gate' AS relation, 'request_gate:tasks' AS subject
FROM "public"."tasks"
WHERE "id" IS NOT NULL;
